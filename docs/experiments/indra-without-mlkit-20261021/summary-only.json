    "no_detector": "one rectangle [0,0,width,height] for the whole frame, not an estimate of subtitle position",
    "subtitle_selector": "none; all detected lines are read, including background text; not a port of E caption selection",
    "timing": "RGB ready -> extraction + optional own detection + recognition + selection + join; image decode/model load/scoring excluded",
    "caution": "Exploratory already-seen frames. Report every fixed condition; no best-per-image oracle selection."
  },
